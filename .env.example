MONGODB_URI=mongodb://127.0.0.1:27017/ws-nest
# Worker request approvals require a replica set. Local example:
# MONGODB_URI=mongodb://127.0.0.1:27017/ws-nest?replicaSet=rs0
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BOOTSTRAP_ADMIN_USERNAME=admin
CHURCH_TIMEZONE=Asia/Singapore
CHURCH_TIMEZONE_OFFSET_MINUTES=480
